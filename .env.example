# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=call_game

# 服务器配置
SERVER_PORT=8080

# JWT配置
JWT_SECRET=your-secret-key-change-in-production

# ============================================
# 用户 API Key 的加密主密钥
# ============================================
# 用户在「设置 → 模型设置」里填的 API Key 会用这把密钥做 AES-256-GCM 加密后入库。
# 生成：openssl rand -base64 32（32 字节；也接受长度正好 32 的原始串）
#
# 丢失或更换它，已存的用户 Key 会**全部解不开**，用户需要重新填写
#（设置页仍会显示掩码，但一调用就报"配置无法解密"）。
# 未配置时服务照常启动，「模型设置」只能读不能写（GET 正常、PUT 报 500）
PREF_ENCRYPTION_KEY=

# ============================================
# AI 复盘分析配置
# ============================================
# 自 BYOK（用户自带 Key）起，这把 Key 不再对任何用户生效，服务端也不再回退它。
# 保留仅为兼容旧部署，可以留空
DEEPSEEK_API_KEY=

# 以下两项不再是"服务端调用用的模型"，而是**默认预设**的取值来源：
# 没配过模型的用户打开「模型设置」时看到的预填值就是它们。
# 走 OpenAI 兼容协议，换供应商只改这里，不用改代码
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名（预填值，用户可以在设置页改成别的）
DEEPSEEK_MODEL=deepseek-chat

# 单次分析超时（秒）。模型返回结构化 JSON 通常需要 20~60 秒
AI_TIMEOUT_SECONDS=120

# 单用户每日分析次数上限。不区分用的是谁的 Key —— 卡的是
#"这个账号一天能发起多少次分析"
# 注意"内容未变时复用已有结论"不消耗额度，因为那种情况根本没调用模型
AI_DAILY_LIMIT=30
