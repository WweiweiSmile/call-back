# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=call_game

# 服务器配置
SERVER_PORT=8080

# JWT配置
JWT_SECRET=your-secret-key-change-in-production

# ============================================
# AI 复盘分析配置
# ============================================
# 密钥申请地址 https://platform.deepseek.com/
# 留空则整个 AI 分析功能自动关闭：接口会返回"服务端未配置 AI"，
# 前端按钮也会置灰并说明原因，不会等到用户点了才报错
DEEPSEEK_API_KEY=

# 模型接口地址。走 OpenAI 兼容协议，换供应商只改这里，不用改代码
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名
DEEPSEEK_MODEL=deepseek-chat

# 单次分析超时（秒）。模型返回结构化 JSON 通常需要 20~60 秒
AI_TIMEOUT_SECONDS=120

# 单用户每日分析次数上限，防止额度被刷爆。
# 注意"内容未变时复用已有结论"不消耗额度，因为那种情况根本没调用模型
AI_DAILY_LIMIT=30
