# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=call_game

# 服务器配置
SERVER_PORT=8080

# ============================================
# 认证（认证中心 call-auth）
# ============================================
# 本服务**只验签、不签发**：登录/注册/刷新/登出/用户信息都已经迁到
# 认证中心 call-auth（默认 :8020）。这里只需要公钥地址
#
# 注意：原先这里有个 JWT_SECRET，默认值硬编码成 "call-game-secret-key-2026" ——
# 只要漏配，服务就会拿着一个人尽皆知的密钥正常启动，谁能伪造任意用户。
# 改成 RS256 后它没有必要了，已删除
AUTH_JWKS_URL=http://localhost:8020/.well-known/jwks.json

# 签发者标识，验签时校验
AUTH_ISSUER=call-auth

# 本服务在 token 的 aud 列表里的名字
AUTH_AUDIENCE=call-back

# 公钥的本地缓存。认证中心拉不到时用它兜底启动 ——
# 没有它的话，「认证中心没起 + 本服务重启」会让全站 401
AUTH_JWKS_CACHE=./runtime/jwks.json

# ============================================
# 用户 API Key 的加密主密钥
# ============================================
# 用户在「设置 → 模型设置」里填的 API Key 会用这把密钥做 AES-256-GCM 加密后入库。
# 生成：openssl rand -base64 32（32 字节；也接受长度正好 32 的原始串）
#
# 丢失或更换它，已存的用户 Key 会**全部解不开**，用户需要重新填写
#（设置页仍会显示掩码，但一调用就报"配置无法解密"）。
# 未配置时服务照常启动，「模型设置」只能读不能写（GET 正常、PUT 报 500）
PREF_ENCRYPTION_KEY=

# ============================================
# 反向代理
# ============================================
# 可信代理的地址或 CIDR，逗号分隔。只有**来自这些地址**的请求，服务才会采信
# X-Forwarded-For / X-Real-IP；否则退回 TCP 对端地址。
#
# 不配（用默认）＝只信任本机 127.0.0.1,::1 —— 覆盖"nginx 与后端同机"的常见形态，
# 且外部客户端伪装不成 127.0.0.1，是安全的。
# 跨机反代（独立 LB）填代理的内网地址，例如 172.16.0.5 或 10.0.0.0/8。
# **设成空串**＝谁都不信任，客户端 IP 一律取 TCP 对端。
#
# ⚠️ 千万别填 0.0.0.0/0 —— 那等于信任所有代理，客户端可以伪造 X-Forwarded-For
#    冒充任意 IP，埋点里的 ip 列会失真（启动日志会对此告警）
TRUSTED_PROXIES=127.0.0.1,::1

# ============================================
# AI 复盘分析配置
# ============================================

# ---- 服务端兜底 Key（普通用户靠它，不需要自己配）----
# 配了它所有用户开箱即用；用户自备的 Key（BYOK）优先，没有才落这里。
# 留空则只有配了自己 Key 的用户能用 AI 分析。**真 Key 只放 .env，这一行必须留空**
AI_SERVER_API_KEY=sk-4fa44d9811ad4050b07c829fd5b153b8
AI_SERVER_BASE_URL=https://api.deepseek.com
AI_SERVER_MODEL=deepseek-flash

# ---- 额度 ----
# 新用户的初始 AI 点数：9 点 = 3 次复盘，也能拆成 9 轮追问或 3 次画像。
# 已存在的用户改库里的 user_ai_quotas.points 充值，不受这里影响。
# 各功能单价（复盘 3 / 对手画像 3 / 画像总结手动 3 / 追问 1）在 config/ai.go 里定
AI_POINT_LIMIT=9

# ---- BYOK 设置页的预填值 ----
# 注意：这两项**不是**服务端调用用的模型（那看上面的 AI_SERVER_*），
# 而是「设置 → 模型设置」（仅管理员可见）里默认预填的地址与模型名
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
